{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ppd:cos:schema:approval-decision:v1",
  "title": "PPD Chief of Staff approval decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "eventType", "decisionId", "approvalHandle", "decision", "requestId",
    "correlationId", "actor", "source", "expectedActionPayloadHash", "createdAt", "expiresAt",
    "idempotencyKey", "adapter"
  ],
  "properties": {
    "schemaVersion": { "const": "ppd.cos.approval-decision.v1" },
    "eventType": { "const": "approval.decision_submitted" },
    "decisionId": { "type": "string", "pattern": "^dec_[a-f0-9]{32}$" },
    "approvalHandle": { "type": "string", "pattern": "^apr_[a-f0-9]{32}$" },
    "decision": { "enum": ["approve", "reject", "amend", "explain", "remind_me"] },
    "requestId": { "type": "string", "pattern": "^req_[a-f0-9]{32}$" },
    "correlationId": { "type": "string", "pattern": "^cor_[a-f0-9]{32}$" },
    "actor": { "$ref": "#/$defs/actor" },
    "source": { "$ref": "#/$defs/source" },
    "expectedActionPayloadHash": { "$ref": "#/$defs/hash" },
    "amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction"],
      "properties": { "instruction": { "type": "string", "minLength": 1, "maxLength": 4096 } }
    },
    "amendmentHash": { "$ref": "#/$defs/hash" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "idempotencyKey": { "$ref": "#/$defs/hash" },
    "adapter": { "$ref": "#/$defs/adapter" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "amend" } }, "required": ["decision"] },
      "then": { "required": ["amendment", "amendmentHash"] },
      "else": { "not": { "anyOf": [{ "required": ["amendment"] }, { "required": ["amendmentHash"] }] } }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["chatUserName", "email", "domainId", "type", "source"],
      "properties": {
        "chatUserName": { "type": "string", "pattern": "^users/[A-Za-z0-9._@-]+$" },
        "email": { "type": ["string", "null"], "format": "email" },
        "domainId": { "type": ["string", "null"] },
        "type": { "const": "HUMAN" },
        "source": { "const": "google_chat_interaction" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "spaceName", "spaceType", "channel", "threadName", "messageName"],
      "properties": {
        "platform": { "const": "google_chat" },
        "spaceName": { "type": "string", "pattern": "^spaces/[A-Za-z0-9_-]+$" },
        "spaceType": { "enum": ["DIRECT_MESSAGE", "SPACE", "GROUP_CHAT"] },
        "channel": { "enum": ["dm", "shared"] },
        "threadName": { "type": ["string", "null"] },
        "messageName": { "type": ["string", "null"] }
      }
    },
    "adapter": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {
        "name": { "const": "ppd-google-chat-cos-adapter" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    }
  }
}
