{
  "name": "ppd-cos-ingestion-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:unit": "tsx --test \"test/unit/**/*.test.ts\"",
    "test:contract": "tsx --test \"test/contract/**/*.test.ts\"",
    "test:integration": "tsx --test \"test/integration/**/*.test.ts\"",
    "test:coverage": "c8 --check-coverage --lines 85 --branches 80 --functions 85 --statements 85 tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "check:secrets": "node test/helpers/secret-scan.mjs",
    "check": "npm run typecheck && npm run test:coverage && npm run check:secrets",
    "audit:runtime": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "c8": "10.1.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
