{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ppd:cos:schema:delivery:v1",
  "title": "PPD Chief of Staff proactive delivery v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "deliveryId", "requestId", "correlationId", "recipient", "destination",
    "sensitivity", "message", "payloadHash", "createdAt", "expiresAt", "idempotencyKey"
  ],
  "properties": {
    "schemaVersion": { "const": "ppd.cos.delivery.v1" },
    "deliveryId": { "type": "string", "pattern": "^delivery_[a-f0-9]{32}$" },
    "requestId": { "type": "string", "pattern": "^req_[a-f0-9]{32}$" },
    "correlationId": { "type": "string", "pattern": "^cor_[a-f0-9]{32}$" },
    "recipient": { "$ref": "#/$defs/user" },
    "destination": {
      "type": "object", "additionalProperties": false,
      "required": ["recipient", "spaceName", "spaceType"],
      "properties": {
        "recipient": { "$ref": "#/$defs/user" },
        "spaceName": { "type": "string", "pattern": "^spaces/[A-Za-z0-9_-]+$" },
        "spaceType": { "enum": ["DIRECT_MESSAGE", "SPACE", "GROUP_CHAT"] }
      }
    },
    "sensitivity": { "enum": ["shared", "personal", "sensitive"] },
    "message": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "cardsV2": { "type": "array", "minItems": 1 },
        "accessoryWidgets": { "type": "array", "minItems": 1 }
      }
    },
    "payloadHash": { "$ref": "#/$defs/hash" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "idempotencyKey": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": { "properties": { "sensitivity": { "const": "sensitive" } }, "required": ["sensitivity"] },
      "then": { "properties": { "destination": { "properties": { "spaceType": { "const": "DIRECT_MESSAGE" } } } } }
    },
    {
      "if": { "properties": { "sensitivity": { "const": "personal" } }, "required": ["sensitivity"] },
      "then": { "properties": { "destination": { "properties": { "spaceType": { "const": "DIRECT_MESSAGE" } } } } }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "user": { "type": "string", "pattern": "^users/[A-Za-z0-9._@-]+$" }
  }
}
